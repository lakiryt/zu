%% 三人の位置を決め、物をその近くに置く
text a "本人(A)"
text c "相手方(C)" right of a
text b "代理人(B)" below a

%% 物は名前の右や下に置ける
parallelogram land "甲土地" below c
cube item "絵画\n(時価100万円)" right of c
cube small "指輪" size small

%% 代理人と土地を同じ段に揃える
align row b land

%% 三者の関係
a ---> b "代理権の授与"
b <-.-> c "意思表示"
a ===>> c "効果帰属"
c ---o land

%% 図の下の文(既定は左詰め)
caption "A の代理人 B が、C と甲土地の売買をした。\n効果は A に帰属する。"
